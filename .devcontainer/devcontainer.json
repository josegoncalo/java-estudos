
{
  "name": "Java 21 - Desenvolvimento",

  "dockerComposeFile": "../docker-compose.yml",

  "service": "java",

  "workspaceFolder": "/workspace",

  "shutdownAction": "stopCompose",

  "customizations": {
    "vscode": {
      "extensions": [
        "redhat.java",
        "vscjava.vscode-java-debug",
        "vscjava.vscode-java-test",
        "vscjava.vscode-maven"
      ]
    }
  }
}
